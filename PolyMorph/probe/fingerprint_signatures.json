    {"header": "x-content-type-options", "expected": "nosniff",    "gap": "MIME-sniff protection absent — browser may interpret polyglot responses as HTML/JS"},
    {"header": "content-security-policy","expected": "any",         "gap": "No CSP — script injection attacks may succeed"},
    {"header": "x-frame-options",        "expected": "any",         "gap": "No clickjacking protection"},
    {"header": "strict-transport-security","expected": "any",       "gap": "No HSTS — downgrade attacks possible"},
