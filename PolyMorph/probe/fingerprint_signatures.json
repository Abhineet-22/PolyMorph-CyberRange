  "polyglot_strategy_map": {
    "PHP": {
      "strategy": "inject",
      "host_formats": ["jpeg", "png", "gif", "pdf", "zip"],
      "payload_format": "php",
      "payload_note": "PHP execution via <?php tag anywhere in file body. Upload restrictions typically check extension or MIME but not body content.",
      "risk": "RCE"
    },
    "ASP.NET": {
      "strategy": "inject",
      "host_formats": ["jpeg", "png"],
      "payload_format": "html",
      "payload_note": "ASPX server-side code can be injected if server misconfigures content-type handling.",
      "risk": "RCE"
    },
    "Java Servlet (JSP)": {
      "strategy": "inject",
      "host_formats": ["zip"],
      "payload_format": "zip",
      "payload_note": "ZIP slip and WAR-based attacks are primary vectors for Java servers.",
      "risk": "RCE / Path Traversal"
    },
    "Node.js": {
      "strategy": "inject",
      "host_formats": ["png", "jpeg"],
      "payload_format": "html",
      "payload_note": "Without X-Content-Type-Options: nosniff, HTML/JS payload in image file can execute in browser if served with wrong MIME.",
      "risk": "XSS / SSRF"
    },
    "Express.js (Node.js)": {
      "strategy": "inject",
      "host_formats": ["png", "jpeg"],
      "payload_format": "html",
      "payload_note": "MIME promotion attack if server lacks nosniff. HTML injected into PNG triggers XSS when served without Content-Type guard.",
      "risk": "XSS"
    },
    "Django (Python)": {
      "strategy": "inject",
      "host_formats": ["jpeg", "png", "pdf"],
      "payload_format": "html",
      "payload_note": "Django ImageField doesn't strip ICC or comment sections — JPEG comment injection persists post-save.",
      "risk": "XSS / Stored injection"
    },
    "Flask (Python)": {
      "strategy": "append",
      "host_formats": ["zip", "png", "pdf"],
      "payload_format": "zip",
      "payload_note": "Flask send_file often does not revalidate content — ZIP appended after PNG passes image check but can be extracted by client.",
      "risk": "Parser differential / SSRF"
    },
    "FastAPI (Python)": {
      "strategy": "append",
      "host_formats": ["zip", "pdf"],
      "payload_format": "zip",
      "payload_note": "FastAPI async file serving with S3 presigned URLs may skip server-side content validation — ZIP append exploits parser differential.",
      "risk": "Parser differential"
    },
    "Ruby on Rails": {
      "strategy": "inject",
      "host_formats": ["jpeg", "png"],
      "payload_format": "html",
      "payload_note": "Active Storage may serve files with original MIME — injection in comment/EXIF section can survive MiniMagick strip in misconfigured setups.",
      "risk": "XSS / Stored injection"
    },
    "No CSP": {
      "strategy": "inject",
      "host_formats": ["html", "png", "jpeg"],
      "payload_format": "html",
      "payload_note": "Absence of Content-Security-Policy means injected scripts execute freely — HTML polyglots are maximally dangerous.",
      "risk": "XSS"
    },
    "MIME-sniff protection absent — browser may interpret polyglot responses as HTML/JS": {
      "strategy": "inject",
      "host_formats": ["png", "jpeg", "gif"],
      "payload_format": "html",
      "payload_note": "Without nosniff, browser MIME-sniffs — image served without Content-Type: image/* can execute embedded HTML/JS.",
      "risk": "XSS"
    },
    "Archive worker detected": {
      "strategy": "append",
      "host_formats": ["jpeg", "png", "gif"],
      "payload_format": "zip",
      "payload_note": "Server-side archive extraction worker processes upload — ZIP appended after image header passes image check but worker extracts payload.",
      "risk": "ZIP slip / path traversal / RCE"
    }
  },
  "surface_strategy_map": {
    "svg_serving": {
      "strategy": "inject",
      "host_formats": ["svg"],
      "payload_format": "html",
      "payload_note": "SVG content detected on target. SVG is an XML DOM format with native W3C <script> support. Unlike binary rasters (PNG/JPEG), SVG bypasses magic-byte upload filters. When served without CSP (script-src 'none') or origin sandboxing, embedded <script> or onload= handlers execute in the full serving origin via <object>/<embed>/<iframe> browsing contexts.",
      "risk": "Stored XSS / DOM Origin Execution (SVG W3C Native Scripting)"
    },
    "media_serving": {
      "strategy": "inject",
      "host_formats": ["png", "jpeg", "gif"],
      "payload_format": "html",
      "payload_note": "Same-origin media served without nosniff — a polyglot PNG/JPEG+HTML injected into the image byte stream will be MIME-sniffed and rendered as HTML by the browser, executing embedded scripts within the site's origin.",
      "risk": "XSS / MIME confusion"
    },
    "doc_processing": {
      "strategy": "append",
      "host_formats": ["pdf", "zip"],
      "payload_format": "zip",
      "payload_note": "Document processing pipeline detected (PDF/DOCX parser). A polyglot PDF+GZIP embeds a pickled payload in the GZIP FCOMMENT field — the same file is simultaneously a valid PDF and a .pickle.gz payload (CVE-2025-64512 pattern). No upload form required; any document ingestion path is a vector.",
      "risk": "RCE / Parser differential (CVE-2025-64512 class)"
    },
    "content_embed": {
      "strategy": "inject",
      "host_formats": ["html", "pdf", "jpeg"],
      "payload_format": "html",
      "payload_note": "Same-origin <iframe>/<object>/<embed> content loading detected without sandbox attribute. A polyglot PDF+HTML or JPEG+HTML file embedded via these tags executes its HTML payload within the parent page origin, bypassing same-origin restrictions.",
      "risk": "XSS / Same-origin bypass"
    },
    "api_ingestion": {
      "strategy": "inject",
      "host_formats": ["jpeg", "png", "pdf"],
      "payload_format": "html",
      "payload_note": "API endpoint accepts binary or multipart data. API-layer file ingestion typically skips server-side MIME validation applied at the HTML form layer — polyglot payloads submitted as raw binary (base64, ArrayBuffer, FormData) bypass content-type checks and reach backend parsers unvalidated.",
      "risk": "Parser differential / RCE / XSS"
    },
    "cloud_storage": {
      "strategy": "append",
      "host_formats": ["jpeg", "png", "zip", "pdf"],
      "payload_format": "zip",
      "payload_note": "Cloud storage (S3/GCS/Azure Blob/CDN) referenced. Cloud object stores preserve file bytes verbatim with no server-side content re-validation. A polyglot uploaded to the bucket is served as-is — if no Content-Disposition: attachment or Content-Type enforcement exists, the browser renders the payload within the CDN origin.",
      "risk": "Parser differential / MIME confusion / CDN supply chain"
    },
    "download_serve": {
      "strategy": "inject",
      "host_formats": ["jpeg", "png", "pdf"],
      "payload_format": "html",
      "payload_note": "File download/serve endpoint detected without Content-Disposition: attachment. Without forcing browser download, a polyglot JPEG+HTML or PNG+HTML served from /download or /files is rendered inline — the HTML payload executes within the site's origin.",
      "risk": "XSS / Inline execution"
    },
    "param_reflection": {
      "strategy": "inject",
      "host_formats": ["png", "jpeg", "pdf"],
      "payload_format": "html",
      "payload_note": "Client-side parameter reflection detected — JavaScript parses URL query parameters (e.g. ?preview= or ?view=) and dynamically embeds media/documents via DOM sinks (<object>, <embed>, <iframe>). When served without nosniff or CSP, a reflected polyglot URL triggers browser MIME sniffing and executes arbitrary JavaScript in the application's origin.",
      "risk": "DOM-Based MIME Confusion / XSS"
    },
    "svg_upload": {
      "strategy": "inject",
      "host_formats": ["svg"],
      "payload_format": "html",
      "payload_note": "SVG upload endpoint detected. SVG is an XML-based vector format that natively supports <script> elements and event-handler attributes (onload, onerror) per the W3C SVG specification. Unlike PNG/JPEG, SVG has no binary magic bytes — it starts with XML text and trivially bypasses binary magic-byte upload filters. When a user-uploaded SVG is served via <object>, <embed>, <iframe>, or direct URL navigation without CSP, embedded scripts execute in the full origin (Stored XSS). DOM execution is suppressed ONLY in <img> context.",
      "risk": "Stored XSS / DOM Origin Execution (SVG W3C Native Scripting)"
    }
  }
}
